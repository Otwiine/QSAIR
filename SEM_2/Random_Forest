    scale=10 # Example scale, adjust based on your needs (e.g., 10 for Sentinel-2)
)

# Part 3: Convert to Pandas DataFrame
def ee_to_pandas(ee_collection):
    """Converts an Earth Engine FeatureCollection to a Pandas DataFrame."""
    # Get a list of all features in the collection.
    feature_list = ee_collection.getInfo()['features']
    # Extract properties from each feature and convert to a list of dictionaries.
    data = [feature['properties'] for feature in feature_list]
    # Create a Pandas DataFrame.
    return pd.DataFrame(data).drop(columns=['crop_type', 'geometry']) # Drop geometry if not needed

