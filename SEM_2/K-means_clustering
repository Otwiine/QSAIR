import ee
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score # Added for optional silhouette score calculation

ee.Initialize()

# 1. Define field boundary (replace with your actual field boundary coordinates)
# Example Polygon (replace with your specific field boundary coordinates)
field_boundary = ee.Geometry.Polygon([
    [[-longitude1, latitude1],
     [-longitude2, latitude2],
     [longitude3, latitude3],
     [longitude4, latitude4],
     [-longitude1, latitude1]]
]) # Ensure these are your specific coordinates

# 2. Get Sentinel-2 imagery for peak growing seasons
s2_collection = (ee.ImageCollection('COPERNICUS/S2_SR')
                 .filterBounds(field_boundary)
                 .filterDate('2022-06-01', '2022-08-31') # Example peak growing season
                 .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 10))) # Less cloud percentage

# Create median composite
composite = s2_collection.median()

# 3. Calculate indices
# NDVI (Normalized Difference Vegetation Index)
ndvi = composite.normalizedDifference(['B8', 'B4']).rename('NDVI')
# NDWI (Normalized Difference Water Index)
ndwi = composite.normalizedDifference(['B3', 'B11']).rename('NDWI')
# MNDWI (Modified Normalized Difference Water Index)
mndwi = composite.normalizedDifference(['B3', 'B11']).rename('MNDWI') # Appears to be a duplicate of NDWI in original, keep both for now

# 4. Create composite with all bands and indices for clustering
# These are the bands used as features for K-means clustering
clustering_bands = [
    'B2', 'B3', 'B4', 'B5', 'B6', 'B7', 'B8', 'B8A', 'B11', 'B12',
    'NDVI', 'NDWI', 'MNDWI'
]
composite_expression = (
    '((B2 * 2.5) + (NIR * 6) + (RED * 7.5) + (BLUE * 1)) / (NDWI * 0.5) + composite.select("B4")'
    # This expression looks complex and potentially incorrect based on typical usage.
    # It might be an attempt to create a custom band or a typo.
    # If the intention is to just stack the bands, remove this line and use .addBands().
    # Assuming the intent is to stack the bands:
)

# Combine bands into a single image for sampling
# Use .addBands to combine all desired bands/indices
clustering_image = composite.addBands([ndvi, ndwi, mndwi]) # Add computed indices

# 5. Create input layers for clustering
# Select the bands that will be used for the clustering algorithm
input_layers_for_clustering = clustering_image.select(clustering_bands)

# 6. Sample image for training K-means
# Sample points from the image within the field boundary
# 'scale' is crucial - controls the resolution of sampling (e.g., 10m for Sentinel-2)
# 'numPixels' limits the number of samples to prevent memory errors for large areas
training_samples = input_layers_for_clustering.sample(
    region=field_boundary,
    scale=10, # Sentinel-2 resolution
    numPixels=5000, # Number of pixels to sample, adjust as needed
    seed=0, # For reproducibility
    tileScale=4 # Scale factor for parallel processing
)

# Prepare data for K-means in Python (from Earth Engine to Pandas DataFrame)
# This converts the sampled data from Earth Engine to a Pandas DataFrame
# for use with scikit-learn.
data = training_samples.getInfo()['features']
properties_list = [f['properties'] for f in data]
df = pd.DataFrame(properties_list)

# Drop any geometry column if present, as it's not needed for KMeans
if 'system:geometry' in df.columns:
    df = df.drop(columns=['system:geometry'])

# Ensure no NaN values, KMeans cannot handle them
df = df.dropna()

# Select the features (bands/indices) for clustering
X = df[clustering_bands] # Make sure these columns exist in your DataFrame

# 7. Determine optimal number of clusters using elbow method
inertias = []
silhouette_scores = []
K_range = range(1, 11) # Test K from 1 to 10

for k in K_range:
    kmeans = KMeans(n_clusters=k, random_state=42, n_init='auto') # n_init='auto' handles multiple initializations
    kmeans.fit(X)
    inertias.append(kmeans.inertia_)
    # Calculate silhouette score only if k > 1 and there's more than 1 cluster.
    # Note: Silhouette score can be slow on large datasets.
    if k > 1 and len(np.unique(kmeans.labels_)) > 1:
        silhouette_scores.append(silhouette_score(X, kmeans.labels_))
    else:
        silhouette_scores.append(np.nan) # Append NaN for k=1 where silhouette is undefined

# Plot Elbow Method
plt.figure(figsize=(10, 5))
plt.plot(K_range, inertias, marker='o')
plt.xlabel('Number of Clusters (K)')
plt.ylabel('Inertia')
plt.title('Elbow Method for Optimal Clusters')
plt.grid(True)
plt.show()

# Plot Silhouette Score (optional)
plt.figure(figsize=(10, 5))
plt.plot(K_range, silhouette_scores, marker='o', color='red')
plt.xlabel('Number of Clusters (K)')
plt.ylabel('Silhouette Score')
plt.title('Silhouette Score for Optimal Clusters')
plt.grid(True)
plt.show()

# Based on elbow plot, choose an optimal K (e.g., 4)
# Here, we assume an optimal K is chosen (e.g., 4)
optimal_k = 4 # Example, derived from visual inspection of the elbow plot

# 8. Run K-means with chosen number of clusters
kmeans_final = KMeans(n_clusters=optimal_k, random_state=42, n_init='auto')
kmeans_final.fit(X)
df['cluster'] = kmeans_final.labels_ # Add cluster labels to DataFrame

