# Define study area (replace with your actual coordinates)
study_area = ee.Geometry.Rectangle([-longitude1, latitude1, longitude2, latitude2]) # Replace with your specific coordinates

# Load Sentinel-2 surface reflectance data collection
s2_collection = (ee.ImageCollection('COPERNICUS/S2_SR')
                 .filterBounds(study_area)
                 .filterDate('2022-05-01', '2022-09-30') # Example growing season dates
                 .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20)))

# Function to add NDVI band to an image
def addNDVI(image):
    # Calculate NDVI (NIR - Red) / (NIR + Red)
    ndvi = image.normalizedDifference(['B8', 'B4']).rename('NDVI')
    return image.addBands(ndvi)

# Map the NDVI function over the collection to get NDVI for each image
s2_collection_with_ndvi = s2_collection.map(addNDVI)

# Get the maximum NDVI value for each pixel across the time period
max_ndvi = s2_collection_with_ndvi.select('NDVI').max()

# Get mean maximum NDVI for study area
mean_ndvi_study_area = max_ndvi.reduceRegion(
    reducer=ee.Reducer.mean(),
    geometry=study_area,
    scale=10 # Resolution of the image data to extract, e.g., 10m for Sentinel-2
).get('NDVI').getInfo()

print(f'Mean maximum NDVI for study area: {mean_ndvi_study_area}')

